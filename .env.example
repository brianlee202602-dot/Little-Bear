# Little Bear 环境变量样例
#
# 使用方式：
#   make env
#
# 重要边界：
# 1. 本文件只保存进程启动、数据库连接、前端构建、Worker 运行、本地容器初始化、
#    一次性 secret 写入和测试脚本参数。
# 2. Redis、MinIO、Qdrant、embedding、rerank、LLM、检索策略、权限策略、缓存策略、
#    限流策略和审计策略等业务配置，生产环境必须通过初始化 / 配置管理写入 PostgreSQL，
#    并由 active_config 驱动 ServiceBootstrap。
# 3. 生产环境不得提交或复用本文件中的示例密码、示例 secret 和本地地址。

# =============================================================================
# 一、生产与开发都需要的运行配置
# =============================================================================

# -----------------------------------------------------------------------------
# 1.1 应用进程配置
# -----------------------------------------------------------------------------

# 当前运行环境。生产建议使用 production，开发使用 local。
APP_ENV=local

# 服务名称，用于日志、健康检查和诊断标识。
SERVICE_NAME=api

# 日志级别。生产通常使用 INFO；排障时可临时调高，但不要输出敏感内容。
LOG_LEVEL=INFO

# API 监听地址与端口。容器内通常监听 0.0.0.0，实际暴露由网关或反向代理控制。
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# 1.2 PostgreSQL 业务事实源连接配置
# -----------------------------------------------------------------------------

# 生产环境应使用强密码、专用账号、受控网络和按需 SSL。
DATABASE_URL=postgresql+psycopg://little_bear:little_bear_dev@localhost:5432/little_bear
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_SSL_MODE=

# -----------------------------------------------------------------------------
# 1.3 Setup 初始化运行配置
# -----------------------------------------------------------------------------

# 管理后台 setup 页面地址，仅用于 API 启动日志提示。
# 本地示例：http://localhost:5174/admin/setup-initialization
# 生产示例：https://admin.example.com/admin/setup-initialization
ADMIN_SETUP_URL=http://localhost:5174/admin/setup-initialization

# 是否在启动日志中输出 setup token。
# 本地开发可开启；生产环境必须关闭，并通过受控初始化流程获取 setup token。
SETUP_TOKEN_LOG_ENABLED=true

# setup token 签名密钥。
# 本地为空时可使用进程内临时密钥；生产环境必须显式设置强随机值。
# 示例生成：openssl rand -base64 64
SETUP_TOKEN_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# 1.4 Secret Store 运行配置
# -----------------------------------------------------------------------------

# Secret Store 主密钥，用于加密 PostgreSQL secrets 表中的密钥值。
# 生产环境必须显式设置、妥善备份，丢失后无法解密既有 secret value。
# 示例生成：openssl rand -base64 64
SECRET_STORE_MASTER_KEY=

# -----------------------------------------------------------------------------
# 1.5 前端 API 地址配置
# -----------------------------------------------------------------------------

# 前端访问 API 的基础地址。该变量会在 Vite 构建时写入前端产物。
# - 本地开发设置为 http://localhost:8000 时，前端直接请求本地 API。
# - 生产推荐留空，让前端使用同源相对路径，并由网关代理 /internal 和 /health 到 API。
# - 如果生产前端和 API 分属不同域，可设置为 https://api.example.com；
#   但当前后端未内置 CORS 中间件，跨域直连需要由 API 网关补齐 CORS。
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 1.6 Worker 运行配置
# -----------------------------------------------------------------------------

# Worker ID 为空时会自动使用 worker-<pid>。
# 生产建议为每个 Worker 副本设置稳定且可识别的 WORKER_ID。
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LOCK_SECONDS=60
WORKER_STAGE_INTERVAL_SECONDS=0

# =============================================================================
# 二、一次性初始化后应删除的明文 Secret
# =============================================================================

# 以下变量只用于初始化或手工执行 secret 写入命令。
# 写入 PostgreSQL secrets 表成功后，应从真实 .env 中删除这些明文值。

# MinIO access key / secret key。生产环境应使用对象存储平台生成的专用凭据。
SECRET_INIT_MINIO_ACCESS_KEY=minioadmin
SECRET_INIT_MINIO_SECRET_KEY=minioadmin

# Qdrant 未开启 API Key 鉴权时保持为空；开启后写入 secret://rag/qdrant/api-key。
SECRET_INIT_QDRANT_API_KEY=

# JWT 签名密钥。生产环境必须使用强随机值。
# 示例生成：openssl rand -base64 64
SECRET_INIT_JWT_SIGNING_KEY=

# =============================================================================
# 三、仅本地开发和测试使用的配置
# =============================================================================

# -----------------------------------------------------------------------------
# 3.1 本地 Docker Compose 容器初始化配置
# -----------------------------------------------------------------------------

# PostgreSQL 本地容器初始化参数。生产数据库不应直接使用这些示例值。
POSTGRES_DB=little_bear
POSTGRES_USER=little_bear
POSTGRES_PASSWORD=little_bear_dev
POSTGRES_PORT=5432

# MinIO 本地容器初始化参数。
# 本地开发时 SECRET_INIT_MINIO_* 默认与这里保持一致。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=little-bear-rag

# -----------------------------------------------------------------------------
# 3.2 真实依赖集成测试配置
# -----------------------------------------------------------------------------

# Qdrant / embedding provider 真实联调测试配置。
# 这些变量只用于测试脚本，不驱动生产业务运行时。
LITTLE_BEAR_QDRANT_URL=http://localhost:6333
LITTLE_BEAR_QDRANT_API_KEY=
LITTLE_BEAR_EMBEDDING_URL=http://localhost:8081
LITTLE_BEAR_EMBEDDING_API_KEY=
LITTLE_BEAR_EMBEDDING_PROVIDER_TYPE=tei
LITTLE_BEAR_EMBEDDING_MODEL=jina-embeddings-v2-base-zh
LITTLE_BEAR_EMBEDDING_DIMENSION=768
LITTLE_BEAR_INTEGRATION_TIMEOUT_SECONDS=30
LITTLE_BEAR_RUN_QDRANT_INTEGRATION=0

# -----------------------------------------------------------------------------
# 3.3 Smoke / 查询回归验收配置
# -----------------------------------------------------------------------------

# P0 smoke 验收配置。
# 该用户必须能登录，并能访问至少一个已发布 active index 的知识库。
LITTLE_BEAR_API_URL=http://localhost:8000
LITTLE_BEAR_SMOKE_USERNAME=
LITTLE_BEAR_SMOKE_PASSWORD=
LITTLE_BEAR_SMOKE_ENTERPRISE_CODE=
LITTLE_BEAR_SMOKE_KB_ID=
LITTLE_BEAR_SMOKE_QUERY=员工手册
LITTLE_BEAR_SMOKE_TOP_K=8
LITTLE_BEAR_SMOKE_REQUIRE_CITATIONS=0
LITTLE_BEAR_SMOKE_TIMEOUT_SECONDS=30
LITTLE_BEAR_SMOKE_RECORD_PATH=

# P0 查询回归配置。
# 默认复用 smoke 用户名和密码；真实验收建议复制 docs/examples/query-regression.p0.jsonl
# 为业务数据集后再执行。
LITTLE_BEAR_QUERY_REGRESSION_DATASET=docs/examples/query-regression.p0.jsonl
LITTLE_BEAR_QUERY_REGRESSION_RECORD_PATH=artifacts/query-regression-latest.json
LITTLE_BEAR_REGRESSION_USERNAME=
LITTLE_BEAR_REGRESSION_PASSWORD=
LITTLE_BEAR_REGRESSION_ENTERPRISE_CODE=
LITTLE_BEAR_REGRESSION_KB_ID=
LITTLE_BEAR_REGRESSION_TIMEOUT_SECONDS=30
